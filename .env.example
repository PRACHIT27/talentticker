# Copy this file to .env and fill in your own values.
# Never commit .env - it is already in .gitignore.

# ---- Claude (used for the "what companies are solving" summaries) ----
ANTHROPIC_API_KEY=sk-ant-...
TT_MODEL=claude-opus-5

# ---- Email alerts ----
# Where new-job alerts get sent.
TT_ALERT_TO=you@example.com

# Any SMTP server works. For Gmail, create an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
# and use that as TT_SMTP_PASS. Your normal Gmail password will not work.
TT_SMTP_HOST=smtp.gmail.com
TT_SMTP_PORT=587
TT_SMTP_USER=you@gmail.com
TT_SMTP_PASS=your-app-password
TT_SMTP_FROM=you@gmail.com

# Set to 1 to print alert emails to the console instead of sending them.
# Useful while testing so you don't spam yourself.
TT_SMTP_DRY_RUN=0

# ---- Storage ----
TT_DB=var/talentticker.db
